<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

    <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:orientation="horizontal">

        <TextView
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:textColor="?attr/colorOnSurface"
                android:layout_weight="1"
                android:id="@+id/tvTicketIdDetail"
                android:textStyle="bold" />

        <Button
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                style="?attr/borderlessButtonStyle"
                android:id="@+id/btnCambiarEstado"
                android:text="Cerrar" />

        <Button
                android:id="@+id/btnEliminarTicket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?attr/borderlessButtonStyle"
                android:layout_marginStart="6dp"
                android:text="Eliminar" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
            android:layout_height="0dp"
            android:layout_width="match_parent"
            android:paddingVertical="10dp"
            android:layout_weight="1"
            android:id="@+id/rvMensajesAdmin" />

    <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:layout_marginBottom="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginStart="10dp">

        <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:background="@drawable/bg_box_message"
                android:gravity="center_vertical"
                android:padding="4dp"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:id="@+id/composerAdmin">

            <EditText
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="Mensaje..."
                    android:layout_margin="6dp"
                    android:textColor="?attr/colorOutline"
                    android:id="@+id/etRespuesta" />

        </LinearLayout>

        <Button
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                app:icon="@drawable/ic_send_24"
                style="?attr/materialIconButtonFilledTonalStyle"
                android:layout_marginStart="8dp"
                android:id="@+id/btnResponder" />

    </LinearLayout>

</LinearLayout>
